# Copy to .env and fill in. All values are optional for local development.
PORT=3000

# Where the SQLite database lives
DATABASE_PATH=./data/bitewise.db

# Service fee charged to customers, in basis points (500 = 5%)
SERVICE_FEE_BPS=500

# Default sales tax for new restaurants, in basis points (1035 = 10.35%, City of Seattle).
# Each restaurant can set its own rate in the portal. Verify rates at
# https://dor.wa.gov/taxes-rates/sales-use-tax-rates/lookup-tax-rate
DEFAULT_TAX_RATE_BPS=1035

# Whether the service fee is included in the taxable amount (true/false). Confirm with your accountant.
TAX_SERVICE_FEE=false

# Stripe. Leave blank to run with the built-in mock payment processor (no real charges).
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

# Set to true when serving over HTTPS so session cookies are marked Secure
COOKIE_SECURE=false

# Map tiles (Leaflet). OpenStreetMap's public tiles are for development/light use only;
# use a tile provider (MapTiler, Stadia Maps, Mapbox...) in production.
MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
# Darken light tiles to match the dark UI (set false if your tile style is already dark)
MAP_DARK_FILTER=true

# Time zone for receipts and daily reports
TIME_ZONE=America/Los_Angeles

# Company details shown in the Terms of Service, Restaurant Partner Agreement and Privacy Policy
LEGAL_ENTITY_NAME=Bite Wise
SUPPORT_EMAIL=support@bitewise.app
LEGAL_ADDRESS=Seattle, Washington

# New restaurants must be approved in the admin console before their offers go live
REQUIRE_RESTAURANT_APPROVAL=true

# 64 hex chars; encrypts restaurant bank account numbers. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, data/encryption.key is created on first run. Back it up either way.
DATA_ENCRYPTION_KEY=
