# ---- Supabase (Dashboard → Project Settings → API). For local dev, `npm run db:start` prints these.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Never expose this key to the browser.
SUPABASE_SECRET_KEY=
# Only for `npm run email:template`, which installs the branded sign-up email in a supabase.com project:
# a personal access token from https://supabase.com/dashboard/account/tokens. Keep it private.
SUPABASE_ACCESS_TOKEN=

# ---- Emails the app sends itself (restaurant "application pending" and "welcome" with the signed agreement and
# kiosk link). Use the same SMTP account as Supabase Auth, e.g. Gmail: smtp.gmail.com, 587, your Gmail address and an
# app password. Without SMTP_HOST these emails are only written to the server log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Optional; defaults to "Bite Wise <SMTP_USER>".
EMAIL_FROM=

# ---- Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
TIME_ZONE=America/Los_Angeles
# Only if you open the app through a tunnel or proxy (e.g. VS Code port forwarding): comma-separated hosts
# allowed to submit forms. Example: TRUSTED_ORIGINS=*.devtunnels.ms,localhost:3000
TRUSTED_ORIGINS=

# ---- Payments (Stripe Connect). Leave the Stripe keys empty to use the built-in mock processor.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Signing secret of the webhook endpoint pointing at /api/stripe/webhook (events: account.updated).
STRIPE_WEBHOOK_SECRET=

# ---- Sales tax. Each restaurant's rate is looked up from its street address (customers pick up there).
# Washington addresses use the WA Department of Revenue's free lookup; elsewhere only the state rate is known
# (flagged in the admin Restaurants tab). For exact rates in every state, turn on Stripe Tax in the Stripe
# dashboard, add your tax registrations there, and set STRIPE_TAX=on (Stripe charges a fee per calculation).
# STRIPE_TAX=on
# TAX_LOOKUP=off turns all lookups off (rates stay as they are).
# TAX_LOOKUP=off

# ---- Menu import (optional). With an Anthropic API key, "Import menu" uses Claude to read menus from restaurant
# websites with unusual layouts; without it, the built-in reader handles standard menu pages and spreadsheets.
ANTHROPIC_API_KEY=

# ---- Cleanup job: Vercel Cron (or any scheduler) calls /api/cron/sweep with this bearer token.
CRON_SECRET=
# A long-running server (npm start) runs the scheduled jobs (card holds, plan renewals) every 5 minutes by itself.
# Set DISABLE_SCHEDULED_JOBS=1 to turn that off when something else calls /api/cron/sweep.
# DISABLE_SCHEDULED_JOBS=1

# ---- Maps (Leaflet). OpenStreetMap's public tiles are fine for development and light use;
# use a commercial tile provider (MapTiler, Stadia, Mapbox...) in production.
NEXT_PUBLIC_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
# Darken light map tiles to match the dark UI. Set to false if your tile provider is already dark.
NEXT_PUBLIC_MAP_DARK_FILTER=true

# ---- Company details shown in the legal documents
LEGAL_ENTITY_NAME=Bite Wise
SUPPORT_EMAIL=support@bitewise.app
LEGAL_ADDRESS=Seattle, Washington
